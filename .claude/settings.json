{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run python -m eval.run_eval *)",
      "Bash(uv run python scripts/smoke_review.py)",
      "Bash(uv run python scripts/smoke_mcp.py)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/format.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/test_gate.py",
            "timeout": 180,
            "statusMessage": "pytest 게이트 실행 중..."
          }
        ]
      }
    ]
  }
}
