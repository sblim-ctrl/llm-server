# ── 필수 ─────────────────────────────────────────────
# llm-postgres 접속 (docker compose 기본값과 일치)
DATABASE_URL=postgresql://budgetops:budgetops@localhost:5433/budgetops_llm

# 인바운드(백엔드 → 우리) 인증용 서비스 토큰. 백엔드가 우리를 호출할 때 실어 보내고
# 우리가 검증한다. 값은 우리가 정해서 백엔드에 전달한다.
SERVICE_TOKEN=dev-service-token-change-me

# 아웃바운드(우리 → 백엔드) 인증용 서비스 토큰. 우리가 백엔드 내부 조회 API를 호출할
# 때 실어 보내고 백엔드가 검증한다. 이 값도 우리가 정해서 백엔드에 전달하지만
# SERVICE_TOKEN과는 반대 방향이라 같은 값을 쓰면 안 된다.
BACKEND_SERVICE_TOKEN=dev-backend-service-token-change-me

# ── LLM ──────────────────────────────────────────────
# 키가 없거나 MOCK_LLM=true면 결정적 목(mock) 응답으로 동작 (개발용)
OPENAI_API_KEY=
MOCK_LLM=true

# ── 백엔드 연동 (아직 미정 — mock으로 개발) ──────────
BACKEND_BASE_URL=http://localhost:8080
MOCK_BACKEND=true

# ── 관측 (선택) ──────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=budgetops-llm

# ── 워커 ─────────────────────────────────────────────
WORKER_POLL_INTERVAL_SEC=2
JOB_MAX_ATTEMPTS=3
