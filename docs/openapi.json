              "queued",
              "running",
              "succeeded",
              "failed",
              "dead"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "AnalyzeAccepted",
        "type": "object"
      },
