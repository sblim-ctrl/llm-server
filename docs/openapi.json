          "external_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Job Id"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "status": {
            "default": "queued",
