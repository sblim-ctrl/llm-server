    },
    {
      "id": "rp-balanced",
      "scenario": "균형 지출(20~30%) — 편중·저활용 경고 없이 최대 단건 안내만",
      "input": {"team_id": "eval-writers-report-balanced", "period": "2026-06"},
      "expect": {
        "verified": true,
        "total_spent": 300000,
        "expense_count": 4,
        "top_category": "식비",
        "recommendations_count": 1,
        "recommendations_contain": ["최대 단건", "분기 회식"],
        "recommendations_not_contain": ["편중", "사용률이 낮습니다"]
      }
    }
  ],
  "briefing_cases": [
    {
