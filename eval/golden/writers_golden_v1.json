      "team_id": "eval-writers-bf-override",
      "precedents": [
        {"category": "식비", "title": "정기 회식", "amount": 45000, "decision": "approve", "decided_by": "AGENT", "is_override": false},
        {"category": "도서", "title": "교재 구입", "amount": 30000, "decision": "approve", "decided_by": "AGENT", "is_override": false},
